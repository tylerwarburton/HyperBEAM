+/// commits has always been recorded first. A no-op unless tracking is on.
+fn track_put(db: &LmdbDatabase, key: &[u8], value: &[u8]) {
+    if !db.tracking.load(Ordering::Acquire) {
+        return;
+    }
+    track_insert(db, key);
+    if let Some(unit) = unit_of(key) {
+        if unit.len() < key.len() {
+            track_insert(db, unit);
+        }
+    }
+    if value.len() > 5 && &value[..5] == b"link:" {
+        let target = &value[5..];
+        for (i, c) in target.iter().enumerate() {
+            if *c == b'/' {
