+/// Delete keys in one write transaction, after committing the overlay.
+/// Returns `{ok, Deleted}` with the number of keys that existed.
+#[rustler::nif(schedule = "DirtyIo")]
+fn delete_batch<'a>(
+    env: Env<'a>,
+    db_handle: ResourceArc<LmdbDatabase>,
+    keys: Vec<Binary>,
+) -> NifResult<Term<'a>> {
+    if let Err(error_msg) = db_handle.validate_database() {
+        return Ok((atoms::error(), atoms::database_error(), error_msg).encode(env));
+    }
+    if db_handle.has_fatal_error.load(Ordering::Relaxed) {
+        return Ok((atoms::error(), atoms::transaction_error(),
+                   "The database failed an earlier commit".to_string()).encode(env));
+    }
+    let key_vecs: Vec<Vec<u8>> = keys.iter().map(|k| k.as_slice().to_vec()).collect();
+    ensure_worker(&db_handle);
+    match delete_sync(&db_handle, key_vecs) {
+        Ok(n) => Ok((atoms::ok(), n).encode(env)),
+        Err(error_msg) => {
+            Ok((atoms::error(), atoms::transaction_error(), error_msg).encode(env))
+        }
     }
 }
 
