+/// being taken after it was read would be lost, so retry until the set the
+/// entry went into is still the current one.
+fn track_insert(db: &LmdbDatabase, entry: &[u8]) {
+    if let Some(ref watch) = **db.watch.load() {
+        if !watch.contains_sync(entry) {
+            return;
+        }
