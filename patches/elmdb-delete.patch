+fn references_watched(value: &[u8], watch: &TrackSet) -> bool {
+    if value.len() > 5 && &value[..5] == b"link:" {
+        let target = &value[5..];
+        if watch.contains_sync(target) {
+            return true;
+        }
+        for (i, c) in target.iter().enumerate() {
+            if *c == b'/' && watch.contains_sync(&target[..i]) {
+                return true;
+            }
+        }
+        false
+    } else {
+        watch.contains_sync(value)
+    }
+}
+
+fn is_id43(value: &[u8]) -> bool {
+    value.len() == 43
+        && value
+            .iter()
+            .all(|c| c.is_ascii_alphanumeric() || *c == b'-' || *c == b'_')
+}
