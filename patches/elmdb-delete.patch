 ///===================================================================
+/// Delete and collector support
+///===================================================================
+
+fn delete_impl<'a>(
+    env: Env<'a>,
+    db_handle: ResourceArc<LmdbDatabase>,
+    keys: Vec<Binary>,
+    guarded: bool,
+) -> NifResult<Term<'a>> {
+    if let Err(error_msg) = db_handle.validate_database() {
+        return Ok((atoms::error(), atoms::database_error(), error_msg).encode(env));
+    }
+    ensure_worker(&db_handle);
+    if db_handle.has_fatal_error.load(Ordering::Acquire) {
+        if let Ok(guard) = db_handle.fatal_error.lock() {
+            if let Some(ref err) = *guard {
+                return Ok((atoms::error(), atoms::transaction_error(), err.clone()).encode(env));
+            }
+        }
+    }
+    let mut key_vecs = Vec::with_capacity(keys.len());
+    for key in keys.iter() {
+        let klen = key.as_slice().len();
+        if klen == 0 || klen > LMDB_DEFAULT_MAX_KEY_SIZE {
+            return Ok((atoms::error(), atoms::validation_error(), format!("Invalid key size {klen}")).encode(env));
+        }
+        key_vecs.push(key.as_slice().to_vec());
+    }
+    match delete_sync(&db_handle, key_vecs, guarded) {
+        Ok(DeleteOutcome::Deleted(n)) => Ok((atoms::ok(), n).encode(env)),
+        Ok(DeleteOutcome::Conflict(found)) => {
+            let mut terms = Vec::with_capacity(found.len());
+            for k in found.iter() {
+                terms.push(encode_binary(env, k)?);
+            }
+            Ok((atoms::error(), atoms::conflict(), terms).encode(env))
+        }
+        Err(error_msg) => Ok((atoms::error(), atoms::transaction_error(), error_msg).encode(env)),
+    }
+}
+
+/// Delete keys. Any put to them that returned before this call is committed
+/// and then deleted in one transaction; a get after this returns `not_found'
+/// until the key is put again. Deleting an absent key is not an error.
+#[rustler::nif(schedule = "DirtyIo")]
+fn delete_batch<'a>(
+    env: Env<'a>,
+    db_handle: ResourceArc<LmdbDatabase>,
+    keys: Vec<Binary>,
+) -> NifResult<Term<'a>> {
+    delete_impl(env, db_handle, keys, false)
+}
+
+/// As `delete_batch', but deletes nothing if any key was written, or named by
+/// a written value, since tracking began or was last taken.
+#[rustler::nif(schedule = "DirtyIo")]
+fn delete_batch_guarded<'a>(
+    env: Env<'a>,
+    db_handle: ResourceArc<LmdbDatabase>,
+    keys: Vec<Binary>,
+) -> NifResult<Term<'a>> {
+    delete_impl(env, db_handle, keys, true)
+}
+
+/// Switch write tracking on or off. Either way the tracked set starts empty.
+#[rustler::nif]
+fn track<'a>(env: Env<'a>, db_handle: ResourceArc<LmdbDatabase>, on: bool) -> NifResult<Term<'a>> {
+    db_handle.tracking.store(on, Ordering::Release);
+    db_handle.tracked.store(Arc::new(new_track_set()));
+    Ok(atoms::ok().encode(env))
+}
+
+/// Restrict tracking (and `scan_watched') to `keys', dropping tracked
+/// entries outside them; `clear' records everything again. Entries tracked
+/// before the watch was set and inside it are kept.
+#[rustler::nif(schedule = "DirtyCpu")]
+fn track_watch<'a>(env: Env<'a>, db_handle: ResourceArc<LmdbDatabase>, keys: Term<'a>) -> NifResult<Term<'a>> {
+    if let Ok(list) = keys.decode::<Vec<Binary>>() {
+        let set = new_track_set();
+        for k in list.iter() {
+            let _ = set.insert_sync(k.as_slice().to_vec());
+        }
+        let set = Arc::new(set);
+        db_handle.watch.store(Arc::new(Some(set.clone())));
+        // Keep what was tracked before the watch and is inside it.
+        let old = db_handle.tracked.swap(Arc::new(new_track_set()));
+        old.iter_sync(|k| {
+            if set.contains_sync(k.as_slice()) {
+                track_insert(&db_handle, k);
+            }
+            true
+        });
+    } else {
+        db_handle.watch.store(Arc::new(None));
+    }
+    Ok(atoms::ok().encode(env))
+}
+
+/// Return the tracked entries and start a fresh set.
+#[rustler::nif(schedule = "DirtyCpu")]
+fn track_take<'a>(env: Env<'a>, db_handle: ResourceArc<LmdbDatabase>) -> NifResult<Term<'a>> {
+    let old = db_handle.tracked.swap(Arc::new(new_track_set()));
+    let mut out: Vec<Vec<u8>> = Vec::with_capacity(old.len());
+    old.iter_sync(|k| {
+        out.push(k.clone());
+        true
+    });
+    let mut terms = Vec::with_capacity(out.len());
+    for k in out.iter() {
+        terms.push(encode_binary(env, k)?);
+    }
+    Ok((atoms::ok(), terms).encode(env))
+}
