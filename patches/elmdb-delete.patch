+fn unit_of(key: &[u8]) -> Option<&[u8]> {
+    if key.len() > 5 && &key[..5] == b"data/" {
+        let end = key[5..].iter().position(|c| *c == b'/').map(|i| i + 5).unwrap_or(key.len());
+        return Some(&key[..end]);
+    }
+    let end = key.iter().position(|c| *c == b'/').unwrap_or(key.len());
+    if is_id43(&key[..end]) { Some(&key[..end]) } else { None }
