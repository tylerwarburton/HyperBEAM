+/// `{ok, Rows, Next}' with `Next' the key to resume from, or `done'. The
+/// overlay is not consulted: a collector tracks writes instead.
+#[rustler::nif(schedule = "DirtyIo")]
+fn scan_refs<'a>(
+    env: Env<'a>,
+    db_handle: ResourceArc<LmdbDatabase>,
+    from: Binary,
+    max_rows: usize,
+) -> NifResult<Term<'a>> {
+    scan_impl(env, db_handle, from, max_rows, 1)
+}
+
+/// As `scan_refs', returning only rows whose key is outside the watch set and
+/// whose value references a key in it (a `link:' target or any path prefix of
+/// it, or a bare ID). Without a watch set, as `scan_refs'.
+#[rustler::nif(schedule = "DirtyIo")]
+fn scan_watched<'a>(
+    env: Env<'a>,
+    db_handle: ResourceArc<LmdbDatabase>,
+    from: Binary,
+    max_rows: usize,
+) -> NifResult<Term<'a>> {
+    scan_impl(env, db_handle, from, max_rows, 2)
+}
+
+/// Every reference row (whatever its own key) naming a watched key or a path
+/// below one: with a watch set of content units, the external references and
+/// the internal edges of those units in one pass.
+#[rustler::nif(schedule = "DirtyIo")]
+fn scan_unit_refs<'a>(
+    env: Env<'a>,
+    db_handle: ResourceArc<LmdbDatabase>,
+    from: Binary,
+    max_rows: usize,
+) -> NifResult<Term<'a>> {
+    scan_impl(env, db_handle, from, max_rows, 3)
+}
+
+/// List up to `max_units' whole content units (see `unit_of') from `from',
+/// in key order, each as `{Unit, Rows, Bytes}', skipping named keys, in one
+/// short read transaction. Returns `{ok, Units, Next | done}'.
+#[rustler::nif(schedule = "DirtyIo")]
+fn scan_units<'a>(
+    env: Env<'a>,
+    db_handle: ResourceArc<LmdbDatabase>,
+    from: Binary,
+    max_units: usize,
+) -> NifResult<Term<'a>> {
+    if let Err(error_msg) = db_handle.validate_database() {
+        return Ok((atoms::error(), atoms::database_error(), error_msg).encode(env));
+    }
+    let (live_env, live_db) = match db_handle.fast_get_handles() {
+        Ok(handles) => handles,
+        Err(error_msg) => {
+            return Ok((atoms::error(), atoms::database_error(), error_msg).encode(env));
+        }
+    };
+    let txn = match RawReadTxn::begin(&live_env) {
+        Ok(txn) => txn,
+        Err(error_msg) => {
+            return Ok((atoms::error(), atoms::transaction_error(), error_msg).encode(env));
+        }
+    };
+    let cursor = match RawCursor::open(&txn, live_db) {
+        Ok(cursor) => cursor,
+        Err(error_msg) => {
+            return Ok((atoms::error(), atoms::database_error(), error_msg).encode(env));
+        }
+    };
+    let from_bytes = from.as_slice();
+    let mut key = ffi::MDB_val { mv_size: from_bytes.len(), mv_data: from_bytes.as_ptr() as *mut _ };
+    let mut value = ffi::MDB_val { mv_size: 0, mv_data: std::ptr::null_mut() };
+    let mut rc = if from_bytes.is_empty() {
+        unsafe { ffi::mdb_cursor_get(cursor.cursor, &mut key, &mut value, ffi::MDB_FIRST) }
+    } else {
+        unsafe { ffi::mdb_cursor_get(cursor.cursor, &mut key, &mut value, ffi::MDB_SET_RANGE) }
+    };
+    let mut units: Vec<(Vec<u8>, usize, usize)> = Vec::new();
+    let mut next: Option<Vec<u8>> = None;
+    while rc == ffi::MDB_SUCCESS {
+        let k = unsafe { slice::from_raw_parts(key.mv_data as *const u8, key.mv_size) };
+        if let Some(unit) = unit_of(k) {
+            let same = units.last().map(|(u, _, _)| u.as_slice() == unit).unwrap_or(false);
+            if same {
+                let last = units.last_mut().unwrap();
+                last.1 += 1;
+                last.2 += key.mv_size + value.mv_size;
+            } else if units.len() >= max_units {
+                next = Some(k.to_vec());
+                break;
+            } else {
+                units.push((unit.to_vec(), 1, key.mv_size + value.mv_size));
+            }
+        }
+        rc = unsafe { ffi::mdb_cursor_get(cursor.cursor, &mut key, &mut value, ffi::MDB_NEXT) };
+    }
+    if rc != ffi::MDB_SUCCESS && rc != ffi::MDB_NOTFOUND {
+        return Ok((atoms::error(), atoms::database_error(), "Failed to advance unit cursor".to_string()).encode(env));
+    }
+    let mut terms = Vec::with_capacity(units.len());
+    for (u, n, b) in units.iter() {
+        terms.push((encode_binary(env, u)?, *n, *b));
+    }
+    let next_term = match next {
+        Some(k) => encode_binary(env, &k)?,
+        None => atoms::done().encode(env),
+    };
+    Ok((atoms::ok(), terms, next_term).encode(env))
+}
+
+/// As `scan_refs', returning every row walked.
+#[rustler::nif(schedule = "DirtyIo")]
+fn scan_rows<'a>(
+    env: Env<'a>,
+    db_handle: ResourceArc<LmdbDatabase>,
+    from: Binary,
+    max_rows: usize,
+) -> NifResult<Term<'a>> {
+    scan_impl(env, db_handle, from, max_rows, 0)
+}
+
+fn scan_impl<'a>(
+    env: Env<'a>,
+    db_handle: ResourceArc<LmdbDatabase>,
+    from: Binary,
+    max_rows: usize,
+    mode: u8,
+) -> NifResult<Term<'a>> {
+    let watch = db_handle.watch.load_full();
+    if let Err(error_msg) = db_handle.validate_database() {
+        return Ok((atoms::error(), atoms::database_error(), error_msg).encode(env));
+    }
+    let (live_env, live_db) = match db_handle.fast_get_handles() {
+        Ok(handles) => handles,
+        Err(error_msg) => {
+            return Ok((atoms::error(), atoms::database_error(), error_msg).encode(env));
+        }
+    };
+    let txn = match RawReadTxn::begin(&live_env) {
+        Ok(txn) => txn,
+        Err(error_msg) => {
+            return Ok((atoms::error(), atoms::transaction_error(), error_msg).encode(env));
+        }
+    };
+    let cursor = match RawCursor::open(&txn, live_db) {
+        Ok(cursor) => cursor,
+        Err(error_msg) => {
+            return Ok((atoms::error(), atoms::database_error(), error_msg).encode(env));
+        }
+    };
+    let from_bytes = from.as_slice();
+    let mut key = ffi::MDB_val { mv_size: from_bytes.len(), mv_data: from_bytes.as_ptr() as *mut _ };
+    let mut value = ffi::MDB_val { mv_size: 0, mv_data: std::ptr::null_mut() };
+    let mut rc = if from_bytes.is_empty() {
+        unsafe { ffi::mdb_cursor_get(cursor.cursor, &mut key, &mut value, ffi::MDB_FIRST) }
+    } else {
+        unsafe { ffi::mdb_cursor_get(cursor.cursor, &mut key, &mut value, ffi::MDB_SET_RANGE) }
+    };
+    let mut rows: Vec<(Vec<u8>, Vec<u8>)> = Vec::new();
+    let mut seen = 0usize;
+    while rc == ffi::MDB_SUCCESS && seen < max_rows {
+        let k = unsafe { slice::from_raw_parts(key.mv_data as *const u8, key.mv_size) };
+        let v = unsafe { slice::from_raw_parts(value.mv_data as *const u8, value.mv_size) };
+        let is_ref = (v.len() > 5 && &v[..5] == b"link:") || is_id43(v);
+        let keep = match (mode, &*watch) {
+            (0, _) => true,
+            (1, _) | (_, None) => is_ref,
+            (3, Some(w)) => is_ref && references_watched(v, w),
+            (_, Some(w)) => is_ref && !w.contains_sync(k) && references_watched(v, w),
+        };
+        if keep {
+            rows.push((k.to_vec(), v.to_vec()));
+        }
+        seen += 1;
+        rc = unsafe { ffi::mdb_cursor_get(cursor.cursor, &mut key, &mut value, ffi::MDB_NEXT) };
+    }
+    if rc != ffi::MDB_SUCCESS && rc != ffi::MDB_NOTFOUND {
+        return Ok((atoms::error(), atoms::database_error(), "Failed to advance scan cursor".to_string()).encode(env));
+    }
+    let next = if rc == ffi::MDB_SUCCESS {
+        let k = unsafe { slice::from_raw_parts(key.mv_data as *const u8, key.mv_size) };
+        encode_binary(env, k)?
+    } else {
+        atoms::done().encode(env)
+    };
+    let mut terms = Vec::with_capacity(rows.len());
+    for (k, v) in rows.iter() {
+        terms.push((encode_binary(env, k)?, encode_binary(env, v)?));
+    }
+    Ok((atoms::ok(), terms, seen, next).encode(env))
+}
