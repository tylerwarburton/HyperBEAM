+/// Commit the overlay, then delete `keys`, in one write transaction. A put to
+/// one of the keys that returned before the delete was sent is committed and
+/// then deleted, never resurrected by a later flush. Absent keys are skipped.
+/// Any failure aborts the transaction (nothing is deleted) and puts the
+/// overlay back, as a failed flush does. Returns the number of keys deleted.
+fn do_flush_delete(db: &LmdbDatabase, keys: &[Vec<u8>]) -> Result<usize, String> {
+    let new_map = Arc::new(new_overlay_map());
+    let old_map = db.active.load_full();
+    db.draining.store(Arc::new(Some(old_map.clone())));
+    db.active.store(new_map);
+    let _ = db.op_count.swap(0, Ordering::AcqRel);
+
+    if let Err(e) = db.env.reopen_if_replaced() {
+        restore_failed_flush(db, old_map);
+        return Err(e);
+    }
+
+    let (live_env, live_db) = match db.fast_get_handles() {
+        Ok(handles) => handles,
+        Err(e) => {
+            restore_failed_flush(db, old_map);
+            return Err(e);
+        }
+    };
+
+    let mut txn = match live_env.begin_rw_txn() {
+        Ok(txn) => txn,
+        Err(_) => {
+            restore_failed_flush(db, old_map);
+            return Err("Failed to begin write transaction".to_string());
+        }
+    };
+
+    let mut write_err = None;
+    (*old_map).iter_sync(|k, v| {
+        if let Err(e) = txn.put(live_db, k, v, WriteFlags::empty()) {
+            write_err = Some(format!("Failed to put value: {:?}", e));
+            return false;
+        }
+        true
+    });
+    let mut deleted = 0usize;
+    if write_err.is_none() {
+        for key in keys {
+            match txn.del(live_db, key, None) {
+                Ok(()) => deleted += 1,
+                Err(lmdb::Error::NotFound) => {}
+                Err(e) => {
+                    write_err = Some(format!("Failed to delete key: {:?}", e));
+                    break;
+                }
+            }
+        }
+    }
+
+    if let Some(e) = write_err {
+        drop(txn);
+        restore_failed_flush(db, old_map);
+        return Err(e);
+    }
+
+    match txn.commit() {
+        Ok(()) => {
+            db.draining.store(Arc::new(None));
+            Ok(deleted)
+        }
+        Err(e) => {
+            restore_failed_flush(db, old_map);
+            Err(format!("Failed to commit delete transaction: {}", e))
+        }
+    }
+}
