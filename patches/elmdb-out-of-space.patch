+/// A commit that failed because the disk or the LMDB map is full. The batch
+/// is back in the overlay (`restore_failed_flush`), so it is NOT fatal: the
+/// caller is answered with the error, the worker stays up, and the next flush
+/// retries it, so writes resume, without a restart, once space is freed.
+/// Before, the worker exited on it and the store refused every write until
+/// the node restarted (public node, 2026-11-21).
+fn out_of_space(e: &str) -> bool {
+    e.contains("No space left") || e.contains("os error 28")
+        || e.contains("MAP_FULL") || e.contains("MapFull")
+}
