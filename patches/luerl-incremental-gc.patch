+%% An incremental cycle. Work is either the live marking state or, after
+%% externalize/internalize, the heaps the cycle started from; the latter is
+%% re-marked from Roots with the Spent budget on the next step, which
+%% reproduces exactly the state the cycle had when it was externalized.
+-record(gc_cycle, {roots,                       %Root values at cycle start
+                   spent=0,                     %Mark budget used so far
+                   work}).                      %Marking state or heaps
+
+%% gc_step(Budget, State) -> {CycleCompleted, State}.
+%% Incremental snapshot-at-the-beginning mark/sweep. The cycle keeps the
+%% immutable heap maps and roots that existed when it began. Objects allocated
+%% later are never swept by that cycle; objects reachable at its start remain
+%% marked even if Lua drops them while the cycle advances. This makes mutation
+%% between steps safe without a write barrier, at the cost of retaining some
+%% floating garbage until the following cycle. It must only begin a cycle
+%% where root_set/1 sees every live value, see gc_nested/1.
+gc_step(RawBudget, St0) ->
+    Budget =
+        case RawBudget of
+            N when is_integer(N), N > 0 -> N;
+            _ -> 1000
+        end,
+    Cycle =
+        case maps:get(?GC_STEP_CYCLE, St0#luerl.private, undefined) of
+            #gc_cycle{}=Existing -> Existing;
+            _ -> new_gc_cycle(St0)
+        end,
+    advance_gc_cycle(Cycle, Budget, St0).
+
+%% gc_nested(State) -> boolean().
+%% True when called from Lua running inside an Erlang function that was
+%% itself called from Lua, e.g. pcall, table.sort or a host callback. The
+%% suspended outer frames, and values the Erlang function holds, are not
+%% roots there, so collection must wait until the outermost call returns.
+gc_nested(#luerl{cs=Cs}) -> bottom_nested(Cs).
+
+bottom_nested([#call_frame{nested=Nested}]) -> Nested;
+bottom_nested([_|Cs]) -> bottom_nested(Cs);
+bottom_nested([]) -> false.
+
+%% gc_defer(Request, State) -> State.
+%% Record a collection requested where gc_nested/1 holds. Requests merge:
+%% a full collection subsumes steps and step budgets add up.
+gc_defer(Req, #luerl{private=Private}=St) ->
+    Next =
+        case {maps:get(?GC_DEFERRED, Private, none),Req} of
+            {collect,_} -> collect;
+            {_,collect} -> collect;
+            {{step,B0},{step,B1}} -> {step,B0 + B1};
+            {none,_} -> Req
+        end,
+    St#luerl{private=Private#{?GC_DEFERRED => Next}}.
+
+%% gc_deferred(Return, State) -> State.
+%% Run a deferred request once the outermost call has returned; only the
+%% globals and its return values are live then.
+gc_deferred(Ret, #luerl{private=Private,stk=Stk}=St0) ->
+    case maps:take(?GC_DEFERRED, Private) of
+        error -> St0;
+        {Req,Private1} ->
+            St1 = St0#luerl{private=Private1,stk=[Ret|Stk]},
+            St2 = case Req of
+                      collect -> gc(St1);
+                      {step,Budget} -> element(2, gc_step(Budget, St1))
+                  end,
+            St2#luerl{stk=Stk}
+    end.
+
+%% gc_count(State) -> Count.
+%% collectgarbage("count"): the number of heap objects, a deterministic
+%% function of the heap rather than of its Erlang encoding.
+gc_count(#luerl{tabs=#tstruct{data=Tt},envs=#tstruct{data=Et},
+                usds=#tstruct{data=Ut},fncs=#tstruct{data=Ft}}) ->
+    float(map_size(Tt) + map_size(Et) + map_size(Ut) + map_size(Ft)).
+
+%% gc_externalize(State) -> State.
+%% gc_internalize(State) -> State.
+%% A pending cycle is stored as its roots, budget spent and the difference
+%% between the heaps it started from and the current heaps, so that a
+%% restored VM continues the cycle exactly as the live VM does.
+gc_externalize(#luerl{private=Private}=St) ->
+    case maps:get(?GC_STEP_CYCLE, Private, undefined) of
+        #gc_cycle{work=Work}=Cycle ->
+            {Tt,Et,Ut,Ft} = cycle_heaps(Work),
+            Delta = {heap_delta(Tt, St#luerl.tabs),
+                     heap_delta(Et, St#luerl.envs),
+                     heap_delta(Ut, St#luerl.usds),
+                     heap_delta(Ft, St#luerl.fncs)},
+            Ext = Cycle#gc_cycle{work={delta,Delta}},
+            St#luerl{private=Private#{?GC_STEP_CYCLE => Ext}};
+        _ -> St
+    end.
+
+gc_internalize(#luerl{private=Private}=St) ->
+    case maps:get(?GC_STEP_CYCLE, Private, undefined) of
+        #gc_cycle{work={delta,{Dt,De,Du,Df}}}=Cycle ->
+            Work = {replay,
+                    heap_undelta(Dt, St#luerl.tabs),
+                    heap_undelta(De, St#luerl.envs),
+                    heap_undelta(Du, St#luerl.usds),
+                    heap_undelta(Df, St#luerl.fncs)},
+            St#luerl{private=Private#{?GC_STEP_CYCLE =>
+                                          Cycle#gc_cycle{work=Work}}};
+        _ -> St
+    end.
+
+cycle_heaps({replay,Tt,Et,Ut,Ft}) -> {Tt,Et,Ut,Ft};
+cycle_heaps({_,_,#gct{t=Tt},#gct{t=Et},#gct{t=Ut},#gct{t=Ft}}) ->
+    {Tt,Et,Ut,Ft}.
+
+%% Entries changed or removed since the cycle began, and keys added since.
+%% Unchanged entries share the current term, so the comparison is cheap.
+heap_delta(Old, #tstruct{data=Cur}) ->
+    Changed = ?FOLD_TABLES(fun (K, V, Acc) ->
+                                   case ?CHK_TABLE(K, Cur) andalso
+                                       ?GET_TABLE(K, Cur) =:= V of
+                                       true -> Acc;
+                                       false -> [{K,V}|Acc]
+                                   end
+                           end, [], Old),
+    Added = ?FOLD_TABLES(fun (K, _, Acc) ->
+                                 case ?CHK_TABLE(K, Old) of
+                                     true -> Acc;
+                                     false -> [K|Acc]
+                                 end
+                         end, [], Cur),
+    {Changed,Added}.
+
+heap_undelta({Changed,Added}, #tstruct{data=Cur}) ->
+    Old0 = lists:foldl(fun (K, D) -> ?DEL_TABLE(K, D) end, Cur, Added),
+    lists:foldl(fun ({K,V}, D) -> ?SET_TABLE(K, V, D) end, Old0, Changed).
+
+new_gc_cycle(#luerl{
+        tabs=#tstruct{data=Tt0},
+        envs=#tstruct{data=Et0},
+        usds=#tstruct{data=Ut0},
+        fncs=#tstruct{data=Ft0}
+    }=St) ->
+    Roots = root_set(St),
+    #gc_cycle{roots=Roots,spent=0,work={replay,Tt0,Et0,Ut0,Ft0}}.
+
+advance_gc_cycle(#gc_cycle{roots=Roots,spent=Spent,
+                           work={replay,Tt,Et,Ut,Ft}}=Cycle, Budget, St) ->
+    %% Marking is deterministic, so one pass with the whole budget spent so
+    %% far plus this step's lands where the original steps did.
+    Work = {Roots,[],#gct{t=Tt,s=#{}},#gct{t=Et,s=#{}},
+            #gct{t=Ut,s=#{}},#gct{t=Ft,s=#{}}},
+    advance_gc_cycle(Cycle#gc_cycle{spent=0,work=Work}, Spent + Budget, St);
+advance_gc_cycle(#gc_cycle{spent=Spent,work={Todo,More,GcT,GcE,GcU,GcF}}=Cycle,
+                 Budget, St) ->
+    case mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget) of
+        {pending,NextTodo,NextMore,NextT,NextE,NextU,NextF} ->
+            Work = {NextTodo,NextMore,NextT,NextE,NextU,NextF},
+            Next = Cycle#gc_cycle{spent=Spent + Budget,work=Work},
+            Private1 = maps:put(?GC_STEP_CYCLE, Next, St#luerl.private),
+            {false,St#luerl{private=Private1}};
+        {done,DoneT,DoneE,DoneU,DoneF} ->
+            Collected = sweep_cycle(DoneT, DoneE, DoneU, DoneF, St),
+            Private1 = maps:remove(?GC_STEP_CYCLE, Collected#luerl.private),
+            {true,Collected#luerl{private=Private1}}
+    end.
