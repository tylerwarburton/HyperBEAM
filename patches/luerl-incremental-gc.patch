+collectgarbage(_, [<<"step">>,RawBudget|_], St) ->
+    Budget =
+        case luerl_lib:arg_to_integer(RawBudget) of
+            N when is_integer(N), N > 0 -> N;
+            _ -> 1000
+        end,
