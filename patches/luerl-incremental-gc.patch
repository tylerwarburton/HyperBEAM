+                    true -> {Free,Data};
+                    false -> {[K|Free],?DEL_TABLE(K, Data)}
+                end
+            end,
+            {Free0,Current0},
+            Snapshot
+        ),
+    Current#tstruct{data=Current1,free=Free1}.
