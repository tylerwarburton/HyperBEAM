+    [Stk,Env,lvs_roots(Lvs),cont_roots([Is|Cont])|frame_roots(Cs)];
+frame_roots([_|Cs]) -> frame_roots(Cs);
+frame_roots([]) -> [].
+
+lvs_roots(Lvs) -> [ tuple_to_list(Lv) || Lv <- Lvs, is_tuple(Lv) ].
+
+cont_roots([[?GFOR_CALL(Func, Data, Val, _)|_]|Cont]) ->
+    [Func,Data,Val|cont_roots(Cont)];
