+%% root_set(State) -> [Value].
+%% Every value the running Lua code can still reach without the heap:
+%% metatables, globals, the value stack and, from the call stack, frame
+%% locals, environments, functions, the arguments held by Erlang functions
+%% and the iterator state generic for loops keep in their continuations.
+root_set(#luerl{g=G,stk=Stk,cs=Cs,meta=Meta}) ->
+    [Meta#meta.nil,Meta#meta.boolean,Meta#meta.number,Meta#meta.string,
+     G,Stk|frame_roots(Cs)].
+
+frame_roots([#call_frame{func=Func,args=Args,lvs=Lvs,env=Env,
+                         is=Is,cont=Cont}|Cs]) ->
+    Held = case Func of
