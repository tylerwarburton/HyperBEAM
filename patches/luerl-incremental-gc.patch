@@ -707,0 +796,161 @@ mark([], [], #gct{s=St}, #gct{s=Se}, #gct{s=Su}, #gct{s=Sf}) ->
+%% The incremental form of mark/6. A budget counts inspected heap values, so a
+%% Lua call can choose its latency/throughput tradeoff without exposing the
+%% collector's internal work lists.
+mark_step(Todo, More, GcT, GcE, GcU, GcF, 0) ->
+    {pending,Todo,More,GcT,GcE,GcU,GcF};
+mark_step([{in_table,_}|Todo], More, GcT, GcE, GcU, GcF, Budget) ->
+    mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget - 1);
+mark_step([#tref{i=T}|Todo], More, #gct{t=Tt,s=Ts0}=GcT,
+          GcE, GcU, GcF, Budget) ->
+    case maps:is_key(T, Ts0) of
+        true ->
+            mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget - 1);
+        false ->
+            Ts1 = Ts0#{ T => true },
+            #table{a=Arr,d=Dict,meta=Meta} = ?GET_TABLE(T, Tt),
+            Aes = array:sparse_to_list(Arr),
+            Des = ttdict:to_list(Dict),
+            mark_step(
+                [Meta|Todo],
+                [[{in_table,T}],Des,Aes,[{in_table,-T}]|More],
+                GcT#gct{s=Ts1},
+                GcE,
+                GcU,
+                GcF,
+                Budget - 1
+            )
+    end;
+mark_step([#eref{i=F}|Todo], More, GcT, #gct{t=Et,s=Es0}=GcE,
+          GcU, GcF, Budget) ->
+    case maps:is_key(F, Es0) of
+        true ->
+            mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget - 1);
+        false ->
+            Es1 = Es0#{ F => true },
+            Ses = tuple_to_list(?GET_TABLE(F, Et)),
+            mark_step(
+                Todo,
+                [Ses|More],
+                GcT,
+                GcE#gct{s=Es1},
+                GcU,
+                GcF,
+                Budget - 1
+            )
+    end;
+mark_step([#usdref{i=U}|Todo], More, GcT, GcE, #gct{s=Us0}=GcU,
+          GcF, Budget) ->
+    case maps:is_key(U, Us0) of
+        true ->
+            mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget - 1);
+        false ->
+            Us1 = Us0#{ U => true },
+            mark_step(
+                Todo,
+                More,
+                GcT,
+                GcE,
+                GcU#gct{s=Us1},
+                GcF,
+                Budget - 1
+            )
+    end;
+mark_step([#funref{i=F,env=Erefs}|Todo], More, GcT, GcE, GcU,
+          #gct{t=Ft0,s=Fs0}=GcF, Budget) ->
+    case maps:is_key(F, Fs0) of
+        true ->
+            mark_step(
+                Todo,
+                [Erefs|More],
+                GcT,
+                GcE,
+                GcU,
+                GcF,
+                Budget - 1
+            );
+        false ->
+            Fs1 = Fs0#{ F => true },
+            Fdef = ?GET_TABLE(F, Ft0),
+            mark_step(
+                [Fdef|Todo],
+                [Erefs|More],
+                GcT,
+                GcE,
+                GcU,
+                GcF#gct{s=Fs1},
+                Budget - 1
+            )
+    end;
+mark_step([#lua_func{funrefs=Funrefs}|Todo], More,
+          GcT, GcE, GcU, GcF, Budget) ->
+    mark_step(
+        Todo,
+        [Funrefs|More],
+        GcT,
+        GcE,
+        GcU,
+        GcF,
+        Budget - 1
+    );
+mark_step([#call_frame{func=Funref,lvs=Lvs,env=Env}|Todo], More0,
+          GcT, GcE, GcU, GcF, Budget) ->
+    More1 = [ tuple_to_list(Lv) || Lv <- Lvs, is_tuple(Lv) ] ++
+        [Env|More0],
+    mark_step(
+        [Funref|Todo],
+        More1,
+        GcT,
+        GcE,
+        GcU,
+        GcF,
+        Budget - 1
+    );
+mark_step([#loop_frame{lvs=Lvs,stk=Stk,env=Env}|Todo], More0,
+          GcT, GcE, GcU, GcF, Budget) ->
+    More1 = [ tuple_to_list(Lv) || Lv <- Lvs, is_tuple(Lv) ] ++
+        [Stk,Env|More0],
+    mark_step(Todo, More1, GcT, GcE, GcU, GcF, Budget - 1);
+mark_step([#erl_func{}|Todo], More, GcT, GcE, GcU, GcF, Budget) ->
+    mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget - 1);
+mark_step([#erl_mfa{}|Todo], More, GcT, GcE, GcU, GcF, Budget) ->
+    mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget - 1);
+mark_step([#thread{}|Todo], More, GcT, GcE, GcU, GcF, Budget) ->
+    mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget - 1);
+mark_step([#userdata{meta=Meta}|Todo], More,
+          GcT, GcE, GcU, GcF, Budget) ->
+    mark_step([Meta|Todo], More, GcT, GcE, GcU, GcF, Budget - 1);
+mark_step([{K,V}|Todo], More, GcT, GcE, GcU, GcF, Budget) ->
+    mark_step([K,V|Todo], More, GcT, GcE, GcU, GcF, Budget - 1);
+mark_step([_|Todo], More, GcT, GcE, GcU, GcF, Budget) ->
+    mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget - 1);
+mark_step([], [Next|More], GcT, GcE, GcU, GcF, Budget) ->
+    mark_step(Next, More, GcT, GcE, GcU, GcF, Budget);
+mark_step([], [], GcT, GcE, GcU, GcF, _Budget) ->
+    {done,GcT,GcE,GcU,GcF}.
+
+%% Sweep only objects that existed at the beginning of this cycle. Current
+%% heap entries allocated since then are intentionally absent from Snapshot and
+%% survive until at least the next cycle.
+sweep_cycle(GcT, GcE, GcU, GcF,
+            #luerl{tabs=Tabs0,envs=Envs0,usds=Usds0,fncs=Fncs0}=St) ->
+    Tabs1 = sweep_tstruct(GcT, Tabs0),
+    Envs1 = sweep_tstruct(GcE, Envs0),
+    Usds1 = sweep_tstruct(GcU, Usds0),
+    Fncs1 = sweep_tstruct(GcF, Fncs0),
+    St#luerl{tabs=Tabs1,envs=Envs1,usds=Usds1,fncs=Fncs1}.
+
+sweep_tstruct(#gct{t=Snapshot,s=Seen},
+              #tstruct{data=Current0,free=Free0}=Current) ->
+    {Free1,Current1} =
+        ?FOLD_TABLES(
+            fun(K, _, {Free,Data}) ->
+                case maps:is_key(K, Seen) of
+                    true -> {Free,Data};
+                    false -> {[K|Free],?DEL_TABLE(K, Data)}
+                end
+            end,
+            {Free0,Current0},
+            Snapshot
+        ),
+    Current#tstruct{data=Current1,free=Free1}.
+
