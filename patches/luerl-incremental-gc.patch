@@ -591,0 +595,74 @@ set_env_var(#eref{i=N}, Index, Val, #luerl{envs=Est0}=St) ->
+%% gc_step(Budget, State) -> {CycleCompleted, State}.
+%% Incremental snapshot-at-the-beginning mark/sweep. The cycle keeps the
+%% immutable heap maps and roots that existed when it began. Objects allocated
+%% later are never swept by that cycle; objects reachable at its start remain
+%% marked even if Lua drops them while the cycle advances. This makes mutation
+%% between steps safe without a write barrier, at the cost of retaining some
+%% floating garbage until the following cycle.
+gc_step(RawBudget, St0) ->
+    Budget =
+        case RawBudget of
+            N when is_integer(N), N > 0 -> N;
+            _ -> 1000
+        end,
+    Cycle =
+        case maps:get(?GC_STEP_CYCLE, St0#luerl.private, undefined) of
+            undefined -> new_gc_cycle(St0);
+            Existing -> Existing
+        end,
+    advance_gc_cycle(Cycle, Budget, St0).
+
+gc_cancel(St) ->
+    St#luerl{
+        private=maps:remove(?GC_STEP_CYCLE, St#luerl.private)
+    }.
+
+%% Approximate the memory reported by Lua's collectgarbage("count") in KiB.
+gc_count(St) ->
+    erlang:external_size(St) / 1024.
+
+object_count(#luerl{
+        tabs=#tstruct{data=Tabs},
+        envs=#tstruct{data=Envs},
+        usds=#tstruct{data=Usds},
+        fncs=#tstruct{data=Fncs}
+    }) ->
+    table_count(Tabs) + table_count(Envs) +
+        table_count(Usds) + table_count(Fncs).
+
+table_count(Data) ->
+    ?FOLD_TABLES(fun(_, _, Count) -> Count + 1 end, 0, Data).
+
+new_gc_cycle(#luerl{
+        tabs=#tstruct{data=Tt0},
+        envs=#tstruct{data=Et0},
+        usds=#tstruct{data=Ut0},
+        fncs=#tstruct{data=Ft0},
+        g=G,stk=Stk,cs=Cs,meta=Meta
+    }) ->
+    Root = [Meta#meta.nil,Meta#meta.boolean,Meta#meta.number,Meta#meta.string,
+            G|Stk],
+    {
+        Root,
+        [Cs],
+        #gct{t=Tt0,s=#{}},
+        #gct{t=Et0,s=#{}},
+        #gct{t=Ut0,s=#{}},
+        #gct{t=Ft0,s=#{}}
+    }.
+
+advance_gc_cycle({Todo,More,GcT,GcE,GcU,GcF}, Budget, St) ->
+    case mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget) of
+        {pending,NextTodo,NextMore,NextT,NextE,NextU,NextF} ->
+            NextCycle =
+                {NextTodo,NextMore,NextT,NextE,NextU,NextF},
+            Private1 = maps:put(?GC_STEP_CYCLE, NextCycle, St#luerl.private),
+            {false,St#luerl{private=Private1}};
+        {done,DoneT,DoneE,DoneU,DoneF} ->
+            Collected = sweep_cycle(DoneT, DoneE, DoneU, DoneF, St),
+            Private0 = maps:remove(?GC_STEP_CYCLE, Collected#luerl.private),
+            Baseline = object_count(Collected),
+            Private1 = maps:put(?GC_STEP_BASELINE, Baseline, Private0),
+            {true,Collected#luerl{private=Private1}}
+    end.
+
