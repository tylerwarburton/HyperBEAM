+%% The incremental form of mark/6. A budget counts inspected heap values, so a
+%% Lua call can choose its latency/throughput tradeoff without exposing the
+%% collector's internal work lists.
+mark_step(Todo, More, GcT, GcE, GcU, GcF, 0) ->
+    {pending,Todo,More,GcT,GcE,GcU,GcF};
+mark_step([{in_table,_}|Todo], More, GcT, GcE, GcU, GcF, Budget) ->
+    mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget - 1);
+mark_step([#tref{i=T}|Todo], More, #gct{t=Tt,s=Ts0}=GcT,
+          GcE, GcU, GcF, Budget) ->
+    case maps:is_key(T, Ts0) of
+        true ->
+            mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget - 1);
+        false ->
+            Ts1 = Ts0#{ T => true },
+            #table{a=Arr,d=Dict,meta=Meta} = ?GET_TABLE(T, Tt),
+            Aes = array:sparse_to_list(Arr),
+            Des = ttdict:to_list(Dict),
+            mark_step(
+                [Meta|Todo],
+                [[{in_table,T}],Des,Aes,[{in_table,-T}]|More],
+                GcT#gct{s=Ts1},
+                GcE,
+                GcU,
+                GcF,
+                Budget - 1
+            )
+    end;
+mark_step([#eref{i=F}|Todo], More, GcT, #gct{t=Et,s=Es0}=GcE,
+          GcU, GcF, Budget) ->
+    case maps:is_key(F, Es0) of
+        true ->
+            mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget - 1);
+        false ->
+            Es1 = Es0#{ F => true },
+            Ses = tuple_to_list(?GET_TABLE(F, Et)),
+            mark_step(
+                Todo,
+                [Ses|More],
+                GcT,
+                GcE#gct{s=Es1},
+                GcU,
+                GcF,
+                Budget - 1
+            )
+    end;
+mark_step([#usdref{i=U}|Todo], More, GcT, GcE, #gct{s=Us0}=GcU,
+          GcF, Budget) ->
+    case maps:is_key(U, Us0) of
+        true ->
+            mark_step(Todo, More, GcT, GcE, GcU, GcF, Budget - 1);
+        false ->
+            Us1 = Us0#{ U => true },
+            mark_step(
+                Todo,
+                More,
+                GcT,
+                GcE,
+                GcU#gct{s=Us1},
+                GcF,
+                Budget - 1
+            )
+    end;
+mark_step([#funref{i=F,env=Erefs}|Todo], More, GcT, GcE, GcU,
+          #gct{t=Ft0,s=Fs0}=GcF, Budget) ->
