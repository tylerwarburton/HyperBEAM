+/// The pending (uncommitted) writes under `prefix`, as a prefix read must see
+/// them: the active map over the draining map, as in `get`.
+///
+/// Prefix reads used to `flush_sync` instead whenever anything was pending.
+/// Under steady writes something always is, so every composite read -- every
+/// message read -- waited for a whole write transaction, and readers queued
+/// behind the single writer thread. That was most of a busy process worker's
+/// time (prod, 2026-11-02: the order-book vault, 312 slots behind).
+///
+/// Called before the read transaction begins. A write is in the maps loaded
+/// here or, if a flush moved it out first, committed before the transaction's
+/// snapshot. The draining map is read on both sides of the active map: if it
+/// changed, a flush swapped the maps in between and the read is retried, so a
+/// newer value in the active map is never overridden by an older one.
+/// No tombstones exist: deletes commit in the writer (`do_flush_delete`).
+fn overlay_prefix_rows(db: &LmdbDatabase, prefix: &[u8]) -> BTreeMap<Vec<u8>, Vec<u8>> {
+    let mut rows = BTreeMap::new();
+    // After a failed flush the overlay holds writes that were not committed:
+    // read only the committed data, as `get` does.
+    if db.has_fatal_error.load(Ordering::Relaxed) {
+        return rows;
+    }
+    loop {
+        let draining = db.draining.load_full();
+        let active = db.active.load_full();
+        if !Arc::ptr_eq(&draining, &db.draining.load_full()) {
+            continue;
+        }
+        rows.clear();
+        if let Some(ref old_map) = *draining {
+            old_map.iter_sync(|k, v| {
+                if k.starts_with(prefix) {
+                    rows.insert(k.clone(), v.clone());
+                }
+                true
+            });
+        }
+        active.iter_sync(|k, v| {
+            if k.starts_with(prefix) {
+                rows.insert(k.clone(), v.clone());
+            }
+            true
+        });
+        return rows;
+    }
+}
+
+/// `read_prefix_rows` when writes under the prefix are pending: the committed
+/// rows with the pending ones laid over them, in key order.
+fn read_prefix_rows_merged<'a>(
+    env: Env<'a>,
+    live_env: &Arc<Environment>,
+    live_db: Database,
+    prefix: &[u8],
+    mut rows: BTreeMap<Vec<u8>, Vec<u8>>,
+) -> NifResult<Term<'a>> {
+    let txn = match live_env.begin_ro_txn() {
+        Ok(txn) => txn,
+        Err(_) => {
+            return Ok((
+                atoms::error(),
+                atoms::transaction_error(),
+                "Failed to begin read transaction".to_string(),
+            )
+                .encode(env));
+        }
+    };
+    {
+        let mut cursor = match txn.open_ro_cursor(live_db) {
+            Ok(cursor) => cursor,
+            Err(_) => {
+                return Ok((
+                    atoms::error(),
+                    atoms::database_error(),
+                    "Failed to open cursor".to_string(),
+                )
+                    .encode(env));
+            }
+        };
+        if cursor.get(Some(prefix), None, MDB_SET_RANGE).is_ok() {
+            for (key, value) in cursor.iter_from(prefix) {
+                if !key.starts_with(prefix) {
+                    break;
+                }
+                // A pending write is newer than the committed row.
+                rows.entry(key.to_vec()).or_insert_with(|| value.to_vec());
+            }
+        }
+    }
+    if rows.is_empty() {
+        return Ok(atoms::not_found().encode(env));
+    }
+    let mut total_size = 0usize;
+    for (key, value) in rows.iter() {
+        total_size = match row_bytes_size(total_size, key.len(), value.len()) {
+            Some(size) => size,
+            None => {
+                return Ok((
+                    atoms::error(),
+                    atoms::validation_error(),
+                    "Packed prefix result too large".to_string(),
+                )
+                    .encode(env));
+            }
+        };
+    }
+    let mut binary = NewBinary::new(env, total_size);
+    let mut offsets = Vec::with_capacity(rows.len());
+    {
+        let out = binary.as_mut_slice();
+        let mut offset = 0usize;
+        for (key, value) in rows.iter() {
+            out[offset..offset + key.len()].copy_from_slice(key);
+            let value_offset = offset + key.len();
+            out[value_offset..value_offset + value.len()].copy_from_slice(value);
+            offsets.push((offset, key.len(), value_offset, value.len()));
+            offset = value_offset + value.len();
+        }
+    }
+    let packed = Term::from(binary).into_binary()?;
+    let mut result = Vec::with_capacity(offsets.len());
+    for (key_offset, key_size, value_offset, value_size) in offsets {
+        result.push((
+            packed.make_subbinary(key_offset, key_size)?,
+            packed.make_subbinary(value_offset, value_size)?,
+        ));
+    }
+    Ok((atoms::ok(), result).encode(env))
+}
